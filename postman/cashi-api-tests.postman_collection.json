        {
          "name": "History - page 1",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{authorization}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Seed 11 more payments once, so history spans two pages (12 in total)",
                  "if (!pm.collectionVariables.get('seeded')) {",
                  "    pm.collectionVariables.set('seeded', 'true');",
                  "    const base = pm.collectionVariables.get('baseUrl');",
                  "    const auth = pm.collectionVariables.get('authorization');",
                  "    for (let i = 1; i <= 11; i++) {",
                  "        pm.sendRequest({",
                  "            url: base + '/api/payments',",
                  "            method: 'POST',",
                  "            header: { 'Content-Type': 'application/json', 'Authorization': auth },",
                  "            body: { mode: 'raw', raw: JSON.stringify({ amount: i, currency: 'EUR', recipientEmail: 'seed' + i + '@example.com' }) }",
                  "        }, (err, res) => {",
                  "            if (err || res.code !== 201) console.error('Seeding payment ' + i + ' failed', err || res.code);",
                  "        });",
                  "    }",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "const page = pm.response.json();",
                  "pm.test('Page has 10 items and a next cursor', () => {",
                  "    pm.expect(page.items).to.have.lengthOf(10);",
                  "    pm.expect(page.nextCursor).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('Items are newest first', () => {",
                  "    const times = page.items.map(p => Date.parse(p.createdAt));",
                  "    for (let i = 1; i < times.length; i++) pm.expect(times[i - 1]).to.be.at.least(times[i]);",
                  "});",
                  "pm.test('Items expose the payment fields only', () => {",
                  "    page.items.forEach(p => pm.expect(p).to.have.all.keys('id', 'amount', 'currency', 'recipientEmail', 'description', 'createdAt'));",
                  "});",
                  "pm.collectionVariables.set('cursor', page.nextCursor);",
                  "pm.collectionVariables.set('page1Ids', JSON.stringify(page.items.map(p => p.id)));"
                ]
              }
            }
          ]
        },
