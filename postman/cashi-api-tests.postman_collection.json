{
  "info": {
    "name": "Cashi API - Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Self-contained test suite. Run the whole collection with the Collection Runner (or `postman collection run`) in order: it registers a fresh user, exercises success and error cases for every endpoint, and fills `authorization` (Bearer token) from the register/login/refresh responses."
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register - success",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"fullName\": \"Test User\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh user on every run so the suite is repeatable",
                  "pm.collectionVariables.set('email', 'user-' + Date.now() + '@example.com');",
                  "pm.collectionVariables.set('seeded', '');",
                  "pm.collectionVariables.set('cursor', '');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "",
                  "pm.test('Returns user and both tokens', () => {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.user.email).to.eql(pm.collectionVariables.get('email'));",
                  "    pm.expect(data.user.fullName).to.eql('Test User');",
                  "    pm.expect(data.tokenType).to.eql('Bearer');",
                  "    pm.expect(data.expiresIn).to.be.above(0);",
                  "    pm.expect(data.accessToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(data.refreshToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(data).to.not.have.property('passwordHash');",
                  "});",
                  "",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', data.accessToken);",
                  "pm.collectionVariables.set('authorization', data.tokenType + ' ' + data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', data.refreshToken);"
                ]
              }
            }
          ]
        },
